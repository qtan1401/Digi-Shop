# Checklist of the variables you type into Render (Dashboard > digishop > Environment). Do not put real values in this file.
# Variables that render.yaml already sets (RATE_LIMIT_STORE, REVIEW_EVENTS_MODE, PRODUCT_IMAGE_STORAGE, PAYMENT_ENV,
# TRUST_PROXY, DB_SSL, DB_POOL_MAX, DB_CONNECT_TIMEOUT_MS, ADMIN_EXTRAS, SMTP_PORT, SMTP_SECURE, JWT_ACCESS_SECRET)
# do not need to be typed again.

# Required, you type these when the Blueprint asks:
APP_ORIGIN=https://<service-name>.onrender.com        # exactly the service URL, no trailing slash
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require   # Neon POOLED url
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
GOOGLE_CLIENT_ID=<same value as your local .env>
# Render free blocks SMTP ports 25/465/587, so Gmail SMTP cannot be used there. render.yaml sets SMTP_PORT=2525.
MAIL_FROM=<sender address verified in Brevo>
SMTP_HOST=smtp-relay.brevo.com
SMTP_USER=<Brevo SMTP login, e.g. xxxx@smtp-brevo.com>
SMTP_PASSWORD=<Brevo SMTP key>
ADMIN_DEFAULT_PASSWORD=<at least 16 characters; use the same value when seeding Neon>

# Optional, add later in the dashboard when you have sandbox keys (without them MoMo and VNPay stay unavailable):
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
VNPAY_IPN_URL=https://<service-name>.onrender.com/api/payments/vnpay/ipn
