generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Product {
  id          Int              @id @default(autoincrement())
  brand       String           @db.VarChar(16)
  deviceType  String           @map("device_type") @db.VarChar(40)
  categoryId  Int              @map("category_id")
  name        String           @db.VarChar(200)
  slug        String           @unique(map: "products_slug_key") @db.VarChar(240)
  image       String           @db.VarChar(500)
  description String           @db.Text
  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  options     ProductOption[]
  variants    ProductVariant[]
  reviews     ProductReview[]
  images      ProductImage[]
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  tags        ProductTag[]

  @@index([isDeleted, updatedAt], map: "products_is_deleted_updated_at_idx")
  @@index([categoryId, isDeleted], map: "products_category_id_is_deleted_idx")
  @@map("products")
}

// Category: admin-managed product group (replaces the fixed device_type list). products.device_type stays as a copy of
// the category slug until a later sprint drops it. The slug is unique among rows that are not soft-deleted: a partial
// unique index ("categories_slug_active_key" ... WHERE is_deleted = false) plus a slug-format CHECK, both created in SQL.
model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @db.VarChar(40)
  name      String    @db.VarChar(80)
  sortOrder Int       @default(0) @map("sort_order")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  Product[]

  @@index([isDeleted, sortOrder], map: "categories_is_deleted_sort_order_idx")
  @@map("categories")
}

// Tag: free-form product attribute (gaming, khong-day, ...), separate from Brand. Same slug rules as Category
// (partial unique index "tags_slug_active_key" ... WHERE is_deleted = false and a slug-format CHECK, created in SQL).
model Tag {
  id        Int          @id @default(autoincrement())
  slug      String       @db.VarChar(40)
  name      String       @db.VarChar(60)
  isDeleted Boolean      @default(false) @map("is_deleted")
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products  ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId Int     @map("product_id")
  tagId     Int     @map("tag_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([productId, tagId])
  @@index([tagId], map: "product_tags_tag_id_idx")
  @@map("product_tags")
}

// Extra gallery photos of a product (the main photo stays in products.image). position is 0-based and unique per product.
model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String   @db.VarChar(500)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, position], map: "product_images_product_id_position_key")
  @@map("product_images")
}

model ProductOption {
  id        Int                  @id @default(autoincrement())
  productId Int                  @map("product_id")
  name      String               @db.VarChar(100)
  position  Int
  isActive  Boolean              @default(true) @map("is_active")
  product   Product              @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name], map: "product_options_product_id_name_key")
  @@unique([productId, position], map: "product_options_product_id_position_key")
  @@index([productId, isActive, position], map: "product_options_product_id_is_active_position_idx")
  @@map("product_options")
}

model ProductOptionValue {
  id           Int                         @id @default(autoincrement())
  optionId     Int                         @map("option_id")
  value        String                      @db.VarChar(100)
  colorHex     String?                     @map("color_hex") @db.VarChar(7)
  position     Int
  isActive     Boolean                     @default(true) @map("is_active")
  option       ProductOption               @relation(fields: [optionId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  variantLinks ProductVariantOptionValue[]

  @@unique([optionId, value], map: "product_option_values_option_id_value_key")
  @@unique([optionId, position], map: "product_option_values_option_id_position_key")
  @@index([optionId, isActive, position], map: "product_option_values_option_id_is_active_position_idx")
  @@map("product_option_values")
}

model ProductVariant {
  id              Int                         @id @default(autoincrement())
  productId       Int                         @map("product_id")
  sku             String                      @unique(map: "product_variants_sku_key") @db.VarChar(100)
  combinationKey  String                      @map("combination_key") @db.Char(64)
  price           Decimal                     @db.Decimal(18, 2)
  // Purchase cost per unit; never shown to customers. CHECK cost_price >= 0.
  costPrice       Decimal                     @default(0) @map("cost_price") @db.Decimal(18, 2)
  stock           Int
  image           String?                     @db.VarChar(500)
  isActive        Boolean                     @default(true) @map("is_active")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  product         Product                     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  optionValues    ProductVariantOptionValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([productId, combinationKey], map: "product_variants_product_id_combination_key_key")
  @@index([productId, isActive], map: "product_variants_product_id_is_active_idx")
  @@map("product_variants")
}

model ProductVariantOptionValue {
  variantId    Int            @map("variant_id")
  optionValueId Int           @map("option_value_id")
  variant      ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  optionValue  ProductOptionValue    @relation(fields: [optionValueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([variantId, optionValueId], map: "product_variant_option_values_pkey")
  @@index([optionValueId], map: "product_variant_option_values_option_value_id_idx")
  @@map("product_variant_option_values")
}

model User {
  id                     String                   @id @db.VarChar(36)
  email                  String?                  @db.VarChar(320)
  username               String?                  @db.VarChar(64)
  fullName               String?                  @map("full_name") @db.VarChar(200)
  passwordHash           String?                  @map("password_hash") @db.VarChar(255)
  role                   String                   @default("user") @db.VarChar(16)
  status                 String                   @default("UNVERIFIED") @db.VarChar(20)
  emailVerifiedAt        DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  failedPasswordAttempts Int                      @default(0) @map("failed_password_attempts")
  passwordLockedAt       DateTime?                @map("password_locked_at") @db.Timestamptz(3)
  forcePasswordChange    Boolean                  @default(false) @map("force_password_change")
  authVersion            Int                      @default(1) @map("auth_version")
  // Loyalty points balance (1 point = 1.000đ). Never negative (CHECK users_loyalty_points_check).
  loyaltyPoints          Int                      @default(0) @map("loyalty_points")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  oauthIdentities        OAuthIdentity[]
  refreshSessions        RefreshSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  cart                   Cart?
  cartMergeOperations    CartMergeOperation[]
  orders                 Order[]
  reviews                ProductReview[]
  addresses              UserAddress[]

  @@map("users")
}

// Saved delivery addresses. At most 10 per user; exactly one has isDefault when any exist
// (enforced in address.repository inside a transaction, backed by a filtered unique index).
model UserAddress {
  id            String   @id @db.VarChar(36)
  userId        String   @map("user_id") @db.VarChar(36)
  recipientName String   @map("recipient_name") @db.VarChar(200)
  phone         String   @db.VarChar(20)
  addressLine   String   @map("address_line") @db.VarChar(500)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "user_addresses_user_id_idx")
  @@map("user_addresses")
}

model OAuthIdentity {
  id              String   @id @db.VarChar(36)
  userId          String   @map("user_id") @db.VarChar(36)
  provider        String   @db.VarChar(32)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  emailSnapshot   String   @map("email_snapshot") @db.VarChar(320)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerSubject], map: "oauth_identities_provider_subject_key")
  @@unique([userId, provider], map: "oauth_identities_user_id_provider_key")
  @@index([userId], map: "oauth_identities_user_id_idx")
  @@map("oauth_identities")
}

model RefreshSession {
  id          String          @id @db.VarChar(36)
  userId      String          @map("user_id") @db.VarChar(36)
  familyId    String          @map("family_id") @db.VarChar(36)
  tokenHash   String          @unique(map: "refresh_sessions_token_hash_key") @map("token_hash") @db.Char(64)
  replacedById String?        @map("replaced_by_id") @db.VarChar(36)
  remembered  Boolean         @default(false)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt  DateTime        @default(now()) @map("last_used_at") @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replacedBy  RefreshSession? @relation("RefreshSessionReplacement", fields: [replacedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replaces    RefreshSession[] @relation("RefreshSessionReplacement")

  @@index([userId, revokedAt], map: "refresh_sessions_user_id_revoked_at_idx")
  @@index([familyId, revokedAt], map: "refresh_sessions_family_id_revoked_at_idx")
  @@index([expiresAt], map: "refresh_sessions_expires_at_idx")
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String   @id @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, usedAt, expiresAt], map: "email_verification_tokens_user_id_used_at_expires_at_idx")
  @@map("email_verification_tokens")
}

// One-time password reset link. Only the SHA-256 of the raw token is stored; the raw token exists only in the email.
model PasswordResetToken {
  id        String   @id @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@map("password_reset_tokens")
}

model Cart {
  id        String     @id @db.VarChar(36)
  userId    String     @unique(map: "carts_user_id_key") @map("user_id") @db.VarChar(36)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        BigInt         @id @default(autoincrement())
  cartId    String         @map("cart_id") @db.VarChar(36)
  variantId Int            @map("variant_id")
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cartId, variantId], map: "cart_items_cart_id_variant_id_key")
  @@map("cart_items")
}

model CartMergeOperation {
  operationId String    @id @map("operation_id") @db.VarChar(64)
  userId      String    @map("user_id") @db.VarChar(36)
  requestHash String    @map("request_hash") @db.Char(64)
  status      String    @db.VarChar(16)
  resultJson  String?   @map("result_json") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "cart_merge_operations_user_id_created_at_idx")
  @@map("cart_merge_operations")
}

model Order {
  id              String      @id @db.VarChar(64)
  userId          String?     @map("user_id") @db.VarChar(36)
  subtotal        Decimal     @db.Decimal(18, 2)
  shippingFee     Decimal     @map("shipping_fee") @db.Decimal(18, 2)
  discount        Decimal     @db.Decimal(18, 2)
  totalPrice      Decimal     @map("total_price") @db.Decimal(18, 2)
  customerName    String      @map("customer_name") @db.VarChar(200)
  customerPhone   String      @map("customer_phone") @db.VarChar(32)
  customerAddress String      @map("customer_address") @db.VarChar(500)
  customerNote    String?     @map("customer_note") @db.VarChar(1000)
  paymentMethod   String      @map("payment_method") @db.VarChar(64)
  orderStatus     String      @map("order_status") @db.VarChar(32)
  paymentStatus   String      @map("payment_status") @db.VarChar(32)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  // Loyalty points: `discount` stays the voucher discount; totalPrice = subtotal + shippingFee - discount - pointsDiscount.
  pointsRedeemed  Int         @default(0) @map("points_redeemed")
  pointsDiscount  Decimal     @default(0) @map("points_discount") @db.Decimal(18, 2)
  pointsEarned    Int         @default(0) @map("points_earned")
  // Idempotency, like order_vouchers.released_at: set when redeemed points were given back / earned points were credited.
  pointsReleasedAt DateTime?  @map("points_released_at") @db.Timestamptz(3)
  pointsCreditedAt DateTime?  @map("points_credited_at") @db.Timestamptz(3)
  // Guest checkout: the email the buyer typed (the confirmation recipient) and the SHA-256 of the random token that
  // lets the buyer, without signing in, read and retry this Order's payment attempts. The token itself is never stored.
  customerEmail   String?     @map("customer_email") @db.VarChar(320)
  guestAccessTokenHash String? @map("guest_access_token_hash") @db.VarChar(64)
  user            User?       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  vouchers        OrderVoucher[]
  statusHistory   OrderStatusHistory[]

  @@index([userId, createdAt], map: "orders_user_id_created_at_idx")
  @@map("orders")
}

model OrderItem {
  id             BigInt         @id @default(autoincrement())
  orderId        String         @map("order_id") @db.VarChar(64)
  variantId      Int            @map("variant_id")
  nameSnapshot   String         @map("name_snapshot") @db.VarChar(200)
  imageSnapshot  String         @map("image_snapshot") @db.VarChar(500)
  skuSnapshot    String         @map("sku_snapshot") @db.VarChar(100)
  optionsSnapshot String        @map("options_snapshot") @db.Text
  unitPrice      Decimal        @map("unit_price") @db.Decimal(18, 2)
  // Variant cost price at the time of purchase, so profit stays correct when the cost changes later.
  unitCost       Decimal        @default(0) @map("unit_cost") @db.Decimal(18, 2)
  quantity       Int
  lineTotal      Decimal        @map("line_total") @db.Decimal(18, 2)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@map("order_items")
}
model PaymentAttempt {
  id                    String    @id @db.VarChar(64)
  orderId               String    @map("order_id") @db.VarChar(64)
  provider              String    @db.VarChar(16)
  amount                Decimal   @db.Decimal(18, 2)
  status                String    @db.VarChar(32)
  providerTransactionId String?   @map("provider_transaction_id") @db.VarChar(100)
  qrPayload             String?   @map("qr_payload") @db.VarChar(2000)
  paymentUrl            String?   @map("payment_url") @db.VarChar(2048)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  inventoryReleasedAt   DateTime? @map("inventory_released_at") @db.Timestamptz(3)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@index([orderId, createdAt], map: "payment_attempts_order_id_created_at_idx")
  @@index([status, expiresAt], map: "payment_attempts_status_expires_at_idx")
  @@map("payment_attempts")
}

model AuditLog {
  id          String   @id @db.VarChar(80)
  actor       String   @db.VarChar(120)
  action      String   @db.VarChar(40)
  entity      String   @db.VarChar(40)
  entityId    String   @map("entity_id") @db.VarChar(80)
  changesJson String   @map("changes_json") @db.Text
  timestamp   DateTime @default(now()) @db.Timestamptz(3)

  @@map("audit_logs")
}

// Voucher: administrator-issued code redeemed on an Order for a Discount.
// Extra CHECK constraints live in the migration (type/percent/max_discount shape,
// redeemed_count <= quantity); Prisma cannot express them.
model Voucher {
  id             Int            @id @default(autoincrement())
  code           String         @unique(map: "vouchers_code_key") @db.VarChar(20)
  description    String         @db.VarChar(200)
  type           String         @db.VarChar(16)
  percent        Int?
  maxDiscount    Decimal?       @map("max_discount") @db.Decimal(18, 2)
  startsAt       DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime       @map("ends_at") @db.Timestamptz(3)
  quantity       Int
  redeemedCount  Int            @default(0) @map("redeemed_count")
  isEnabled      Boolean        @default(true) @map("is_enabled")
  isListed       Boolean        @default(true) @map("is_listed")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders         OrderVoucher[]

  @@map("vouchers")
}

// One row per Voucher redeemed on an Order, holding a snapshot so later Voucher edits
// never rewrite order history. releasedAt is set when the quantity was given back.
model OrderVoucher {
  orderId         String    @map("order_id") @db.VarChar(64)
  voucherId       Int       @map("voucher_id")
  codeSnapshot    String    @map("code_snapshot") @db.VarChar(20)
  typeSnapshot    String    @map("type_snapshot") @db.VarChar(16)
  percentSnapshot Int?      @map("percent_snapshot")
  discountAmount  Decimal   @map("discount_amount") @db.Decimal(18, 2)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(3)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  voucher         Voucher   @relation(fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([orderId, voucherId])
  @@index([voucherId], map: "order_vouchers_voucher_id_idx")
  @@map("order_vouchers")
}

model ProductReview {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  userId    String?  @map("user_id") @db.VarChar(36)
  // Display name typed by an anonymous commenter (userId is null then). Guests cannot rate.
  guestName String?  @map("guest_name") @db.VarChar(60)
  rating    Int?     @db.SmallInt
  comment   String?  @db.VarChar(1000)
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // One review per signed-in user per product is a filtered unique index (WHERE user_id IS NOT NULL), created in SQL.
  @@index([productId, isHidden, createdAt], map: "product_reviews_product_idx")
  @@map("product_reviews")
}

// One row each time an Order enters a status (including its first), so customers can see the full timeline.
model OrderStatusHistory {
  id        BigInt   @id @default(autoincrement())
  orderId   String   @map("order_id") @db.VarChar(64)
  status    String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId, createdAt], map: "order_status_history_order_id_created_at_idx")
  @@map("order_status_history")
}
