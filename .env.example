# App and migration URLs: locally PostgreSQL; on Neon use pooled for app and direct for migrations.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/digishop
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/digishop_test
DB_POOL_MAX=10
DB_SSL=false
# Optional: DB_CONNECT_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=<random-secret-at-least-32-bytes>
GOOGLE_CLIENT_ID=<google-client-id>
APP_ORIGIN=<https://app.example.invalid>

# MoMo production credentials and callback configuration
MOMO_PARTNER_CODE=<momo-partner-code>
MOMO_ACCESS_KEY=<momo-access-key>
MOMO_SECRET_KEY=<momo-secret-key>

# VNPay production credentials. Register the IPN URL in the VNPay merchant portal.
VNPAY_TMN_CODE=<8-character-merchant-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_PAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_IPN_URL=<https://app.example.invalid/api/payments/vnpay/ipn>
MAIL_FROM=<verified-sender@example.invalid>
SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_SECURE=<true-or-false>
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
ADMIN_DEFAULT_PASSWORD=<initial-admin-password-required-when-creating-admin>

# Local product image storage; production will use Cloudinary in Sprint 5.
PRODUCT_IMAGE_STORAGE_DIR=./data/product-images

# Set to "sandbox" to use MoMo/VNPay test endpoints and test credentials
PAYMENT_ENV=

# Number of reverse-proxy hops in front of the app (e.g. 1 on Railway); leave empty locally
TRUST_PROXY=

# Admin features outside the brief (review moderation, audit log view, admin account creation, payment
# reconciliation). Hidden and answered with 404 unless set to 1.
ADMIN_EXTRAS=0
