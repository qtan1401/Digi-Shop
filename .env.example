DATABASE_URL=sqlserver://<host>:1433;database=DigiShop;user=<user>;password=<password>;encrypt=true;trustServerCertificate=true;schema=dbo
DB_SERVER=<host>
DB_PORT=1433
DB_NAME=DigiShop
DB_USER=<user>
DB_PASSWORD=<password>
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_MAX=10

JWT_ACCESS_SECRET=<random-secret-at-least-32-bytes>
GOOGLE_CLIENT_ID=<google-client-id>
APP_ORIGIN=<https://app.example.invalid>

# MoMo production credentials and callback configuration
MOMO_PARTNER_CODE=<momo-partner-code>
MOMO_ACCESS_KEY=<momo-access-key>
MOMO_SECRET_KEY=<momo-secret-key>

# VNPay production credentials. Register the IPN URL in the VNPay merchant portal.
VNPAY_TMN_CODE=<8-character-merchant-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_PAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_IPN_URL=<https://app.example.invalid/api/payments/vnpay/ipn>
MAIL_FROM=<verified-sender@example.invalid>
SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_SECURE=<true-or-false>
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
ADMIN_DEFAULT_PASSWORD=<initial-admin-password-required-when-creating-admin>

# Mount a durable host volume at this directory for product images.
PRODUCT_IMAGE_STORAGE_DIR=./data/product-images
